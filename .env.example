# Copy this file to .env and fill in real values. Never commit .env.
#
# Vars prefixed EXPO_PUBLIC_ are inlined into the client bundle at build time —
# only put values here that are safe to ship to a device (Supabase's anon key
# is designed for this; it's constrained by Row Level Security, not secrecy).
# Anything else (ANTHROPIC_API_KEY, a Supabase service_role key, etc.) must live
# server-side only — as Supabase Edge Function secrets — and must NEVER be
# prefixed EXPO_PUBLIC_ or referenced from app code.

# Supabase project (Settings > API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: PostHog analytics
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Server-side only (set as Supabase Edge Function secrets, NOT here) ---
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# YOUTUBE_DATA_API_KEY=
